{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "模块共用的 TS 配置：modules/<name>/tsconfig.json 里 extends 它",
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "noEmit": true, "jsx": "react-jsx", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "isolatedModules": true, "forceConsistentCasingInFileNames": true
  }
}
